# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
URI_MONGO=mongodb://admin:adminpassword@localhost:27017/OpinionManagerDB?authSource=admin

# JWT Configuration
JWT_SECRET=MyVerySecretKeyForOpinionManager2026!
JWT_EXPIRES_IN=8h
JWT_ISSUER=OpinionManagerAuth
JWT_AUDIENCE=OpinionManagerUsers

# SMTP Configuration (Para envío de tokens/verificación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_de_google
EMAIL_FROM=no-reply@opinionmanager.com
EMAIL_FROM_NAME=Opinion Manager Support

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
CLOUDINARY_FOLDER=opinion_manager_profiles
CLOUDINARY_DEFAULT_AVATAR_FILENAME=default-avatar.png